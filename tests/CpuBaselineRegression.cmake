function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "Expected exit ${expected}, got ${result}\n${output}\n${errors}")
    endif()
    string(REPLACE "\r" "" output "${output}")
    set(log "${output}" PARENT_SCOPE)
endfunction()

function(require_field field)
    string(FIND "\n${log}" "\n${field}\n" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing ${field}\n${log}")
    endif()
endfunction()

set(easy "${SOURCE_DIR}/data/easy.kttsp")
set(fixture "${SOURCE_DIR}/tests/fixtures/cpu-easy-fragment-seed7-earliest.sol")
if(MODE STREQUAL "fixture")
    run(0 validate "${easy}" "${fixture}")
    require_field("policy=strict")
    require_field("status=ok")
    require_field("completion.days=177.19440349732923")
    require_field("exceptions=5")
    require_field("orbital.final_validation=48")
    return()
endif()

file(MAKE_DIRECTORY "${WORK_DIR}")
if(MODE STREQUAL "smoke")
    set(instance "${WORK_DIR}/circular.kttsp")
    set(first "${WORK_DIR}/first.sol")
    set(second "${WORK_DIR}/second.sol")
    set(third "${WORK_DIR}/third.sol")
    set(trace "${WORK_DIR}/diagnostic.kttspq")
    set(traceReplay "${WORK_DIR}/diagnostic-replay.kttspq")
    set(failed "${WORK_DIR}/failed.sol")
    file(REMOVE "${first}" "${second}" "${third}" "${failed}" "${trace}" "${traceReplay}")
    file(WRITE "${instance}" "p kttsp 2 0.125 2.25 0.01 1 1\n10000000 0 0 0 0 0\n10000000 0 0 0 0 0\n10000000 0 0 0 0 0\n")
    set(options --assembly-seed 7 --timing-seed 0 --attempts 8 --shortlist 2 --schedule-calls 16)
    run(0 solve "${instance}" "${first}" ${options} --matrix-calls 48)
    require_field("status=ok")
    require_field("orbital.final_validation=2")
    require_field("completion.days=2.25")
    string(REGEX REPLACE "seconds[^\n]*\n" "" firstLog "${log}")
    run(0 solve "${instance}" "${second}" ${options} --matrix-calls 48 --trace "${trace}" --profile on)
    string(REGEX REPLACE "(seconds|profile|trace)\\.[^\n]*\n" "" secondLog "${log}")
    file(SHA256 "${first}" firstHash)
    file(SHA256 "${second}" secondHash)
    if(NOT firstLog STREQUAL secondLog OR NOT firstHash STREQUAL secondHash)
        message(FATAL_ERROR "Repeated solves changed the export or non-timing counters")
    endif()
    string(REGEX MATCH "orbital.total=([0-9]+)" matched "${log}")
    set(records "${CMAKE_MATCH_1}")
    require_field("trace.records=${records}")
    require_field("profile.final_validation.calls=2")
    file(READ "${trace}" traceHex HEX)
    string(LENGTH "${traceHex}" traceSize)
    math(EXPR expectedSize "2 * (8 + 24 * ${records})")
    if(NOT traceSize EQUAL expectedSize OR NOT traceHex MATCHES "^4b5454535051310a")
        message(FATAL_ERROR "Incorrect binary trace header or record count")
    endif()
    # Final validation of this synthetic solution departs at 2.125 for 0.125 days.
    if(NOT traceHex MATCHES "0000000000000140000000000000c03f$")
        message(FATAL_ERROR "Trace changed the binary64 values of the final query")
    endif()
    run(0 solve "${instance}" "${third}" ${options} --matrix-calls 48 --trace "${traceReplay}" --schedule-cache-index hash)
    require_field("config.schedule_cache_index=hash")
    string(REGEX REPLACE "((seconds|trace)\\.[^\n]*|config.schedule_cache_index=[^\n]*)\n" "" thirdLog "${log}")
    string(REGEX REPLACE "config.schedule_cache_index=[^\n]*\n" "" comparableLog "${firstLog}")
    file(SHA256 "${third}" thirdHash)
    file(SHA256 "${trace}" traceHash)
    file(SHA256 "${traceReplay}" traceReplayHash)
    if(NOT traceHash STREQUAL traceReplayHash OR NOT firstHash STREQUAL thirdHash OR NOT comparableLog STREQUAL thirdLog)
        message(FATAL_ERROR "The hashed cache changed the orbital query sequence or solve results")
    endif()
    run(1 solve "${instance}" "${first}" ${options} --matrix-calls 0)
    file(SHA256 "${first}" afterRefusal)
    if(NOT firstHash STREQUAL afterRefusal)
        message(FATAL_ERROR "Existing export was overwritten")
    endif()
    run(0 validate "${instance}" "${first}")
    require_field("exceptions=0")
    require_field("orbital.final_validation=2")
    file(APPEND "${second}" "extra\n")
    run(1 validate "${instance}" "${second}")
    run(2 solve "${instance}" "${failed}" ${options} --matrix-calls 0)
    require_field("status=no_complete_order")
    require_field("orbital.total=0")
    run(2 solve "${instance}" "${failed}" ${options} --matrix-calls 48 --schedule-calls 0)
    require_field("status=no_feasible_schedule")
    if(EXISTS "${failed}" OR EXISTS "${failed}.pending")
        message(FATAL_ERROR "A failed run left a solution export")
    endif()
elseif(MODE STREQUAL "replay")
    set(export "${WORK_DIR}/easy-replay.sol")
    file(REMOVE "${export}")
    run(0 solve "${easy}" "${export}")
    require_field("status=ok")
    require_field("assembly.unique_orders=1")
    require_field("shortlist.count=1")
    require_field("selected.method=earliest")
    require_field("orbital.matrix=1204224")
    require_field("orbital.schedule_discovery=3999952")
    require_field("orbital.schedule_validation=96")
    require_field("orbital.final_validation=48")
    require_field("orbital.total=5204320")
    require_field("completion.days=177.19440349732923")
    require_field("exceptions=5")
    file(SHA256 "${fixture}" fixtureHash)
    file(SHA256 "${export}" exportHash)
    if(NOT fixtureHash STREQUAL exportHash)
        message(FATAL_ERROR "Phase 6C fixture hash ${fixtureHash} differs from export ${exportHash}\n${log}")
    endif()
    message("${log}")
else()
    message(FATAL_ERROR "Unknown CPU baseline test mode ${MODE}")
endif()
